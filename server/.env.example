# Copy to server/.env (never committed; the server scripts load it, and real environment variables win over it).
OMP_PORT=3000
OMP_BASE_URL=http://localhost:3000
OMP_DB_PATH=data/omp.sqlite   # relative paths resolve against the repo root
# Required for POST /api/* writes until organizer accounts exist. Generate: openssl rand -hex 24
OMP_ADMIN_TOKEN=change-me

# Paid tickets (optional; without these, paid classes show as unavailable and free reservations still work).
# Test-mode keys only for demos. See docs/STRIPE_SETUP.md.
#OMP_STRIPE_SECRET_KEY=sk_test_...
#OMP_STRIPE_WEBHOOK_SECRET=whsec_...   # from the Connect webhook endpoint, or `stripe listen --forward-connect-to localhost:3000/webhooks/stripe`
#OMP_STRIPE_CLIENT_ID=ca_...           # only for "Connect with Stripe" OAuth; pasting a connected account id works without it
#OMP_STRIPE_ACCOUNT=acct_...           # seed only: connects the demo organization to this test account on `npm run seed`
