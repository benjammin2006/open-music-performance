#!/bin/sh
# Local gate, zero hosted-CI minutes. Runs the repo test script before every push.
# Installed by `npm install` via the root "prepare" script (git config core.hooksPath .githooks).
# Do not bypass with --no-verify; fix the gate instead.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: npm test"
npm test --silent
