# docker compose reads this file as .env. Never commit .env.
OMP_DOMAIN=tickets.example.org          # Caddy obtains a certificate for this name (DNS must point here)
OMP_BASE_URL=https://tickets.example.org
OMP_ADMIN_TOKEN=change-me               # openssl rand -hex 24 ; guards the raw write API
# Paid tickets, optional. Each organizer connects their own Stripe account from the admin; these are the instance's platform keys.
# See docs/STRIPE_SETUP.md. Leave unset to run with free reservations only.
OMP_STRIPE_SECRET_KEY=
OMP_STRIPE_WEBHOOK_SECRET=
OMP_STRIPE_CLIENT_ID=
